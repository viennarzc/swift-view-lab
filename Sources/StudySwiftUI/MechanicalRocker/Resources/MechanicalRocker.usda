#usda 1.0
(
    defaultPrim = "MechanicalRocker"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "MechanicalRocker"
{
    def Xform "Bezel"
    {
        def Cube "BezelMesh"
        {
            color3f[] primvars:displayColor = [(0.07, 0.08, 0.10)] (interpolation = "constant")
            float3 xformOp:scale = (1.5, 0.18, 1.0)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Xform "RockerPivot"
    {
        float3 xformOp:translate = (0, 0.16, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "RockerFace"
        {
            color3f[] primvars:displayColor = [(0.04, 0.05, 0.06)] (interpolation = "constant")
            float3 xformOp:scale = (1.25, 0.16, 0.78)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }

        def Sphere "Indicator"
        {
            color3f[] primvars:displayColor = [(0.15, 0.86, 0.42)] (interpolation = "constant")
            double radius = 0.075
            float3 xformOp:translate = (0.93, 0.20, 0.53)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
